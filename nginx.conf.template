# ==============================================================================
# INDUS GRAMMAR SCHOOL ERP - NGINX REVERSE PROXY CONFIGURATION (UBUNTU)
# Place in: /etc/nginx/sites-available/indus-erp.conf
# Enable with: ln -s /etc/nginx/sites-available/indus-erp.conf /etc/nginx/sites-enabled/
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN.COM www.YOUR_DOMAIN.COM;

    # Client body limit for student photo, document and receipt uploads
    client_max_body_size 64M;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Location for Let's Encrypt SSL verification
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Reverse Proxy to Docker Web Container
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }
}
